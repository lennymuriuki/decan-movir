{
  "name": "decan-movie-desktop",
  "version": "1.0.4",
  "description": "Decan Movie Windows Desktop Application",
  "main": "src/main.js",
  "author": "Lenny Muriuki - Decan Konnect",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "co.ke.decankonnect.decanmovie.desktop",
    "productName": "Decan Movie",
    "artifactName": "Decan-Movie-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Decan Movie",
      "uninstallDisplayName": "Decan Movie",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Decan-Movie-${version}-Portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lennymuriuki",
      "repo": "decan-movir",
      "releaseType": "release"
    }
  }
}
